{
  "expo": {
    "name": "Deadline",
    "slug": "deadline",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dantochi.deadline",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.dantochi.deadline"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F1F1EC"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-system-ui",
      [
        "expo-media-library",
        {
          "photosPermission": "Deadline saves your life grid wallpaper to your photos.",
          "savePhotosPermission": "Deadline saves your life grid wallpaper to your photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/doto/800ExtraBold/Doto_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/schibsted-grotesk/600SemiBold/SchibstedGrotesk_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "LifeSmall",
              "label": "Deadline \u00b7 Weeks left",
              "description": "Your weeks left, at a glance",
              "minWidth": "110dp",
              "minHeight": "50dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 7200000,
              "widgetCategory": "home_screen|keyguard"
            },
            {
              "name": "LifeMedium",
              "label": "Deadline \u00b7 Life in years",
              "description": "Weeks left and your whole life in years",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 7200000
            },
            {
              "name": "LifeLarge",
              "label": "Deadline \u00b7 Next ten years",
              "description": "Weeks left, your next deadline and the next ten years in weeks",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 7200000
            },
            {
              "name": "Tasks",
              "label": "Deadline \u00b7 Deadlines",
              "description": "Your most urgent deadlines",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 7200000
            }
          ]
        }
      ]
    ],
    "scheme": "deadline",
    "backgroundColor": "#0B0C0E",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5a3ce26f-47bb-487f-b871-fe48c608bdac"
      }
    },
    "owner": "dantochi"
  }
}
