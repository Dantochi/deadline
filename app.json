{
  "expo": {
    "name": "Deadline",
    "slug": "deadline",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dantochi.deadline",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.dantochi.deadline"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F1F1EC"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-system-ui",
      [
        "expo-media-library",
        {
          "photosPermission": "Deadline saves your life grid wallpaper to your photos.",
          "savePhotosPermission": "Deadline saves your life grid wallpaper to your photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "scheme": "deadline",
    "backgroundColor": "#0B0C0E",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5a3ce26f-47bb-487f-b871-fe48c608bdac"
      }
    },
    "owner": "dantochi"
  }
}
